# 应用环境
APP_ENV=development

# 后端服务基础地址
API_BASE_URL=http://localhost:8000

# 独立算法服务地址
ALGORITHM_SERVICE_BASE_URL=http://localhost:8100
ALGORITHM_SERVICE_TIMEOUT_MS=2000

# 前端 API 地址
# 本地开发默认推荐使用 Vite 代理，因此建议保持为 /api
# 如果前端需要直连后端，可改为 http://localhost:8000
VITE_API_BASE_URL=/api

# 后端允许跨域访问的前端来源，多个地址使用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Open-Meteo 上游接口地址
WEATHER_API_BASE_URL=https://api.open-meteo.com
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com

# Nixtla 异常检测接口（可选）
NIXTLA_API_BASE_URL=https://api.nixtla.io
NIXTLA_API_KEY=
NIXTLA_TIMEOUT_MS=4000

# 是否启用本地 mock / fallback
ENABLE_MOCK_FALLBACK=true

# 默认城市配置
DEFAULT_CITY=Beijing
DEFAULT_LATITUDE=39.9042
DEFAULT_LONGITUDE=116.4074
DEFAULT_TIMEZONE=Asia/Shanghai

# 工作流配置
WORKFLOW_ID=main
FORECAST_DAYS=7
AQ_FORECAST_DAYS=5
ENABLE_ANOMALY_DETECTION=true

# 风险阈值配置
RISK_MEDIUM_THRESHOLD=40
RISK_HIGH_THRESHOLD=70

# 上游超时配置（毫秒）
WEATHER_TIMEOUT_MS=5000
AIR_QUALITY_TIMEOUT_MS=5000
ANALYSIS_TIMEOUT_MS=2000
